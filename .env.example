# Kopiér denne fil til .env.local og udfyld med de rigtige værdier.
# .env.local må ALDRIG committes til git (den står i .gitignore).

# Offentlige Supabase-nøgler (findes under Project Settings > API i Supabase).
# Disse må gerne være i browseren - de er beskyttet af Row Level Security, ikke ved at være hemmelige.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kun til brug på serveren (fx senere til AI-berigelse i Etape 5). Må ALDRIG eksponeres til klienten.
# SUPABASE_SERVICE_ROLE_KEY=
# ANTHROPIC_API_KEY=
